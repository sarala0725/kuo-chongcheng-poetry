# OpenAI image generation
OPENAI_API_KEY=

# GitHub repository that Vercel should update, e.g. owner/repository
GITHUB_REPOSITORY=
GITHUB_BRANCH=main
GITHUB_TOKEN=

# Set to a long random value. Vercel Cron sends it as Bearer authorization.
PUBLISH_CRON_SECRET=

# CounterAPI v2 visitor counter (server-side only)
COUNTERAPI_WORKSPACE=
COUNTERAPI_COUNTER=visitors
COUNTERAPI_TOKEN=
